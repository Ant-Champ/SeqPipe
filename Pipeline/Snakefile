# ======================================================================
# Pipeline :: main Snakefile
# ----------------------------------------------------------------------
# One pipeline for Oxford Nanopore (ONT) long reads and paired-end short
# reads (Element AVITI / Illumina), against GenBank references of
# plasmids / phages / bacterial genomes.
#
# Every sample has a `platform` (ont | element | illumina) in the sample
# sheet; ONT and short-read samples can be mixed in one run. Steps whose
# tool differs by read type (filtering, alignment, variant calling,
# assembly) have an *_ont and an *_sr rule writing the same output path,
# so everything downstream is shared.
#
# Analyses are switched on/off for the whole run in config.yaml (run_*
# keys, see the template). A step that does not apply to a read type
# (multimers for short reads) is simply not requested for those samples.
#
# Layout:
#   Snakefile          <- this file (entry point)
#   rules/*.smk        <- included rule modules
#   envs/*.yaml        <- per-rule conda environments
#   scripts/*.py       <- analysis scripts
#   run.sh             <- launcher (inside a salloc allocation)
#
# Run with (see README.md):   ./run.sh /path/to/config.yaml
# ======================================================================

import glob
import os
import re
import sys
import pandas as pd
from snakemake.utils import min_version

min_version("7.0")

PIPELINE_DIR = workflow.basedir


# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
OUT_DIR = os.path.join(config["out_dir"], "")        # trailing slash guaranteed
REF_DIR = os.path.join(config["ref_dir"], "")

# Removed keys: every sample now gives its own FASTQ path(s) and reference in
# the sheet. Stop rather than silently ignore them.
_obsolete = [k for k in ("fastq_dir", "fastq_base_name", "default_reference") if k in config]
if _obsolete:
    raise WorkflowError(
        f"config key(s) {', '.join(_obsolete)} are no longer used: remove them from config.yaml and "
        "give each sample its full FASTQ path(s) (reads1/reads2) and its reference in the sample sheet."
    )

# Scripts live in <pipeline>/scripts unless script_dir points elsewhere;
# per-script filenames can be overridden in config['script'].
SCRIPT_DIR = config.get("script_dir") or os.path.join(PIPELINE_DIR, "scripts")
SCRIPTS = config.get("script", {}) or {}

def script_path(name_key, default):
    """Resolve a script path from config['script'][name_key], else a default."""
    return os.path.join(SCRIPT_DIR, SCRIPTS.get(name_key, default))


# ----------------------------------------------------------------------
# Analysis toggles (whole run, not per sample)
# ----------------------------------------------------------------------
# Alignment to the sample's reference always runs: most analyses and the
# summary need the BAM. `run_alignment_analysis` is the old (ONT pipeline)
# name of run_variant_calling and is still accepted.
RUN_FILTERING      = config.get("run_read_filtering", True)
RUN_VARIANTS       = config.get("run_variant_calling", config.get("run_alignment_analysis", True))
RUN_GATC           = RUN_VARIANTS and config.get("run_gatc_annotation", True)
RUN_COVERAGE       = config.get("run_coverage_analysis", True)
RUN_SV             = config.get("run_sv_scan", True)
RUN_MULTIMER       = config.get("run_multimer_analysis", True)
RUN_DENOVO         = config.get("run_denovo_assembly", False)
RUN_PLASMID_SCREEN = config.get("run_plasmid_screen", False)
RUN_CASSETTES      = config.get("run_cassette_search", False)
RUN_REPORT         = config.get("run_html_report", True)

# Renamed keys (IGV was replaced by pictures drawn by the pipeline,
# scripts/snapshot_regions.py): the old names are still read, with a warning.
for _old, _new in (("run_igv_snapshots", "run_hotspot_pictures"), ("igv_flank", "picture_flank"),
                   ("report_embed_igv", "report_embed_pictures")):
    if _old in config:
        print(f"WARNING: config key {_old} is now called {_new}: please rename it in config.yaml.",
              file=sys.stderr)
        config.setdefault(_new, config[_old])
_ignored = [k for k in ("igv_exe", "igv_heap_mb", "igv_mem_mb", "snapshot_tool") if k in config]
if _ignored:
    print(f"WARNING: config key(s) {', '.join(_ignored)} are no longer used (IGV was removed: the "
          "pipeline draws the hotspot pictures itself). You can delete them.", file=sys.stderr)
RUN_PICTURES       = RUN_CASSETTES and config.get("run_hotspot_pictures", False)  # a picture of every hotspot

if "run_cassette_hotspots" in config:
    print("WARNING: run_cassette_hotspots / cassette_reference are no longer used: cassette locations "
          "are now found by run_cassette_search with the cassettes of cassette_dir (see README).",
          file=sys.stderr)



SEQ_EXTENSIONS = ".gb/.gbk/.genbank/.fasta/.fa/.fna"


def _find_sequences(folder):
    """Every sequence of a folder (cassette_dir, plasmid_panel_dir): one per
    GenBank/FASTA file, named after the file (file_recordid if a file holds
    several records)."""
    from Bio import SeqIO
    found = []
    for path in sorted(glob.glob(os.path.join(folder, "*"))):
        ext = os.path.splitext(path)[1].lower()
        fmt = {".gb": "genbank", ".gbk": "genbank", ".genbank": "genbank",
               ".fasta": "fasta", ".fa": "fasta", ".fna": "fasta"}.get(ext)
        if not fmt:
            continue
        stem = os.path.splitext(os.path.basename(path))[0]
        recs = list(SeqIO.parse(path, fmt))
        for i, rec in enumerate(recs):
            rid = rec.id if re.match(r"[A-Za-z0-9][A-Za-z0-9._-]*$", rec.id or "") else str(i + 1)
            name = stem if len(recs) == 1 else f"{stem}_{rid}"
            found.append({"name": re.sub(r"[^\w.-]", "_", name), "path": path, "format": fmt, "index": i})
    dups = sorted({s["name"] for s in found if [t["name"] for t in found].count(s["name"]) > 1})
    if dups:
        raise WorkflowError(f"same sequence name from several files in {folder}: {dups} -- rename the files")
    return found


def _load_sequence_dir(key, enabled):
    """Sequences of the folder config[key]; crash now (not mid-run) if it is unusable."""
    folder = config.get(key, "")
    if not enabled:
        return []
    if not folder or not os.path.isdir(folder):
        raise WorkflowError(
            f"{key} is not a folder: '{folder}' (relative paths are read from the "
            f"config's folder, {os.getcwd()}; an absolute path is safer)")
    seqs = _find_sequences(folder)
    if not seqs:
        raise WorkflowError(f"no {SEQ_EXTENSIONS} files in {key} ({folder})")
    return seqs


# Cassettes searched in every sample (rules/cassettes.smk), and the plasmid
# panel checked against every sample (rules/plasmid_screen.smk).
CASSETTES     = _load_sequence_dir("cassette_dir", RUN_CASSETTES)
PLASMID_PANEL = _load_sequence_dir("plasmid_panel_dir", RUN_PLASMID_SCREEN)


# ----------------------------------------------------------------------
# Samples
# ----------------------------------------------------------------------
# Columns (all required, tab-separated):
#   sample_name  platform  reads1  reads2  reference
# reads1/reads2 = full FASTQ paths (reads2 empty for ONT); relative paths are
# relative to the run folder (the folder of config.yaml). reference = GenBank
# file in ref_dir (with or without .gb) or a full path. Every problem in the
# sheet is collected and reported at once, before anything runs.
samples = pd.read_table(config["sample_sheet"], dtype=str, comment="#").fillna("")
samples.columns = [c.strip() for c in samples.columns]

if {"barcode", "ref_fasta"} & set(samples.columns):
    raise WorkflowError(
        "old ONT sample sheet (barcode / ref_fasta columns) is no longer accepted: use the columns "
        "sample_name, platform, reads1, reads2, reference with the full FASTQ path in reads1 "
        "(see template/sample_sheet.tsv)."
    )
_missing = {"sample_name", "platform", "reads1", "reads2", "reference"} - set(samples.columns)
if _missing:
    raise WorkflowError(
        f"sample_sheet is missing required column(s): {', '.join(sorted(_missing))} "
        "-- is it tab-separated? (columns: sample_name platform reads1 reads2 reference)"
    )
samples = samples.apply(lambda col: col.str.strip())
samples["platform"] = samples["platform"].str.lower()

if samples["sample_name"].duplicated().any():
    raise WorkflowError(
        f"sample_sheet has duplicated sample_name values: "
        f"{sorted(set(samples.loc[samples['sample_name'].duplicated(), 'sample_name']))}"
    )

_FASTQ_RE = re.compile(r"\.f(ast)?q(\.gz)?$")


def _ref_path(ref):
    if not re.search(r"\.(gb|gbk|genbank)$", ref):
        ref += ".gb"
    return ref if os.path.isabs(ref) else REF_DIR + ref


_errors = []
for _i, _row in samples.iterrows():
    _s = _row["sample_name"] or f"(row {_i + 2})"
    if not _row["sample_name"]:
        _errors.append(f"row {_i + 2}: empty sample_name")
    if _row["platform"] not in ("ont", "element", "illumina"):
        _errors.append(f"{_s}: platform '{_row['platform']}' (use ont | element | illumina)")
    _reads = [("reads1", _row["reads1"])]
    if _row["platform"] == "ont":
        if _row["reads2"]:
            _errors.append(f"{_s}: ONT sample with a reads2 value (leave reads2 empty for ONT)")
    elif _row["platform"] in ("element", "illumina"):
        _reads.append(("reads2", _row["reads2"]))
    for _col, _path in _reads:
        if not _path:
            _errors.append(f"{_s}: {_col} is empty")
        elif not _FASTQ_RE.search(_path):
            _errors.append(f"{_s}: {_col} '{_path}' is not a FASTQ path (.fastq/.fq, optionally .gz)")
        elif not os.path.isfile(_path):
            _errors.append(f"{_s}: {_col} file not found: {_path}")
    if not _row["reference"]:
        _errors.append(f"{_s}: reference is empty")
    elif not os.path.isfile(_ref_path(_row["reference"])):
        _errors.append(f"{_s}: reference file not found: {_ref_path(_row['reference'])}")
if _errors:
    raise WorkflowError(
        f"{len(_errors)} problem(s) in sample_sheet {config['sample_sheet']}:\n  " + "\n  ".join(_errors)
    )

samples = samples.set_index("sample_name", drop=False)

SAMPLE_NAMES = list(samples["sample_name"])
ONT_SAMPLES  = [s for s in SAMPLE_NAMES if samples.at[s, "platform"] == "ont"]
SR_SAMPLES   = [s for s in SAMPLE_NAMES if samples.at[s, "platform"] != "ont"]


# ----------------------------------------------------------------------
# Wildcard constraints (some samples names have ".*")
# ----------------------------------------------------------------------
def _alternation(names):
    """Regex matching exactly these names; matches nothing for an empty list."""
    return "|".join(re.escape(s) for s in names) if names else "(?!x)x"

ONT_RE = _alternation(ONT_SAMPLES)
SR_RE  = _alternation(SR_SAMPLES)

wildcard_constraints:
    sample=_alternation(SAMPLE_NAMES)


# ----------------------------------------------------------------------
# Include rule modules (relative paths -> portable across machines)
# ----------------------------------------------------------------------
include: "rules/common.smk"
include: "rules/qc.smk"
include: "rules/align.smk"

if RUN_VARIANTS:
    include: "rules/variants.smk"
if RUN_COVERAGE:
    include: "rules/coverage.smk"
if RUN_SV:
    include: "rules/sv.smk"
if RUN_MULTIMER and ONT_SAMPLES:
    include: "rules/multimer.smk"
if RUN_DENOVO:
    include: "rules/assembly.smk"
if RUN_PLASMID_SCREEN:
    include: "rules/plasmid_screen.smk"
if RUN_CASSETTES:
    include: "rules/cassettes.smk"

include: "rules/summary.smk"
if RUN_REPORT:
    include: "rules/report.smk"


# ----------------------------------------------------------------------
# Target rule
# ----------------------------------------------------------------------
def _rule_all_inputs(wildcards=None):
    """Build rule-all targets from the RUN_* toggles above. Per-sample targets
    only for the samples that passed the depth check (ok_samples)."""
    OK = ok_samples()
    ONT_OK = [s for s in OK if s in ONT_SAMPLES]
    d = {
        "depth_checks": depth_checks(),
        "sorted_bams": expand(OUT_DIR + "{sample}/{sample}.sorted.bam", sample=OK),
        "flagstats":   expand(OUT_DIR + "{sample}/{sample}.flagstat.txt", sample=OK),
        "run_summary": OUT_DIR + "summary.tsv",
    }
    if RUN_VARIANTS:
        d["align_snps"] = expand(OUT_DIR + "{sample}/{sample}.simple.tsv", sample=OK)
    if RUN_GATC:
        d["annotated_gatc_align_snps"] = expand(OUT_DIR + "{sample}/{sample}.annotated.gatc.simple.tsv", sample=OK)
    if RUN_COVERAGE:
        d["coverage_regions"] = expand(OUT_DIR + "{sample}/annotated/{sample}.{level}_coverage.annotated.tsv",
                                       sample=OK, level=["low", "high"])
    if RUN_SV:
        d["sv"] = expand(OUT_DIR + "{sample}/annotated/{sample}.{table}.annotated.tsv",
                         sample=OK, table=["indels", "breakpoints"])
    if RUN_MULTIMER and ONT_SAMPLES:
        d["multimer_logs"] = expand(OUT_DIR + "{sample}/{sample}.multimer.log", sample=ONT_OK)
    if RUN_DENOVO:
        d["assemblies"]     = expand(OUT_DIR + "{sample}/{sample}.assembly.fasta", sample=OK)
        d["assembly_infos"] = expand(OUT_DIR + "{sample}/{sample}.assembly_info.txt", sample=OK)
    if RUN_CASSETTES:
        d["cassette_tables"] = expand(
            OUT_DIR + "{sample}/annotated/{sample}.cassette_{table}.annotated.tsv",
            sample=OK, table=["insertions", "junctions", "hotspots"]
        )
        d["cassette_counts"] = expand(OUT_DIR + "{sample}/cassettes/{sample}.cassette_counts.tsv", sample=OK)
    if RUN_PICTURES:
        d["cassette_pictures"] = expand(OUT_DIR + "{sample}/cassettes/pictures", sample=OK)
    if RUN_COVERAGE or RUN_PLASMID_SCREEN:
        d["coverage_summary"] = OUT_DIR + "coverage_summary.tsv"
    if RUN_REPORT:
        d["report"] = OUT_DIR + "report.html"
    return d


rule all:
    input:
        unpack(_rule_all_inputs)


# ----------------------------------------------------------------------
# Coverage summary merge (only defined when at least one coverage source
# is active). reference_coverage_summary.tsv (rules/coverage.smk) and
# plasmid_coverage_summary.tsv (rules/plasmid_screen.smk) share one
# schema, so merging is a straight concatenation.
# ----------------------------------------------------------------------
if RUN_COVERAGE or RUN_PLASMID_SCREEN:

    def _coverage_summary_sources():
        sources = []
        if RUN_COVERAGE:
            sources.append(OUT_DIR + "reference_coverage_summary.tsv")
        if RUN_PLASMID_SCREEN:
            sources.append(OUT_DIR + "plasmid_coverage_summary.tsv")
        return sources


    rule merge_coverage_summaries:
        """Combine the reference-genome and plasmid-panel coverage tables into one."""
        input:
            _coverage_summary_sources(),
        output:
            summary = OUT_DIR + "coverage_summary.tsv",
        log:
            OUT_DIR + "logs/merge_coverage_summaries.log",
        run:
            header = None
            n_rows = 0
            with open(output.summary, "w") as out_fh, open(log[0], "w") as log_fh:
                for path in input:
                    with open(path) as in_fh:
                        lines = in_fh.read().splitlines()
                    if not lines:
                        log_fh.write(f"skipped {path} (empty)\n")
                        continue
                    if header is None:
                        header = lines[0]
                        out_fh.write(header + "\n")
                    elif lines[0] != header:
                        raise WorkflowError(
                            f"cannot merge {path}: header does not match the "
                            f"other coverage table(s) ({lines[0]!r} vs {header!r})"
                        )
                    for line in lines[1:]:
                        out_fh.write(line + "\n")
                        n_rows += 1
                    log_fh.write(f"merged {path} ({len(lines) - 1} data rows)\n")
                log_fh.write(f"total data rows: {n_rows}\n")
