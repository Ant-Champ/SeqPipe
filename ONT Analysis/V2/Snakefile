# ======================================================================
# NanoForge :: main Snakefile
# ----------------------------------------------------------------------
# ONT analysis pipeline for plasmid/small-genome samples: reference-based
# variant calling, de novo assembly, and/or plasmid-panel screening, run
# from a shared config.
#
# The three analysis branches are toggled globally (whole run, not per
# sample) from config.yaml -- see the RUN_* flags below:
#   run_alignment_analysis : medaka variant calling vs. a reference
#                            (+ optional coverage / multimer / GATC
#                            sub-analyses, each independently toggleable)
#   run_denovo_assembly    : Flye de novo assembly, no reference needed
#   run_plasmid_screen     : map reads against a shared panel of
#                            candidate plasmids, per-plasmid coverage
# Enable any combination for a given run.
#
# Portable layout (Snakemake best-practice):
#  NanoForgeFolder/
#   Snakefile          <- this file (entry point)
#   rules/*.smk        <- included rule modules
#   envs/*.yaml        <- per-rule conda environments
#   scripts/*.py       <- your analysis scripts (move them here)
#  CurrentRunFolder/
#   config.yaml          <- run configuration
#
# Run with:
#   snakemake --snakefile Snakefile \
#             --configfile config.yaml \
#             --use-conda --cores N
# ======================================================================

import os
import re
from pathlib import Path
import pandas as pd
from snakemake.utils import min_version

min_version("7.0")


# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------

OUT_DIR   = os.path.join(config["out_dir"], "")        # trailing slash guaranteed
FASTQ_DIR = os.path.join(config["fastq_dir"], "")
REF_DIR   = os.path.join(config["ref_dir"], "")

FASTQ_BASE_NAME = config.get("fastq_base_name", "")
FILTER_MODE     = config.get("filter_mode", "")
SCRIPT_DIR = config.get("script_dir", "")

# Per-script filenames come from config so you never hardcode them in rules.
SCRIPTS = config.get("script", {})

def script(name_key, default):
    """Resolve a script path from config['script'][name_key], else a default."""
    return os.path.join(SCRIPT_DIR, SCRIPTS.get(name_key, default))


# ----------------------------------------------------------------------
# Analysis toggles (whole run, not per sample)
# ----------------------------------------------------------------------
# The three branches below are independent -- enable any combination.
# The three alignment sub-toggles only have an effect when the
# reference-based branch itself is enabled.
RUN_ALIGNMENT      = config.get("run_alignment_analysis", True)
RUN_DENOVO         = config.get("run_denovo_assembly", False)
RUN_PLASMID_SCREEN = config.get("run_plasmid_screen", False)

RUN_COVERAGE  = RUN_ALIGNMENT and config.get("run_coverage_analysis", True)
RUN_MULTIMER  = RUN_ALIGNMENT and config.get("run_multimer_analysis", True)
RUN_GATC      = RUN_ALIGNMENT and config.get("run_gatc_annotation", True)

# Directory of candidate plasmid fasta(s) for the panel-screening branch --
# the same panel is checked against every sample (see rules/plasmid_screen.smk).
PLASMID_PANEL_DIR = os.path.join(config["plasmid_panel_dir"], "") if config.get("plasmid_panel_dir") else ""

if not RUN_ALIGNMENT and not RUN_DENOVO and not RUN_PLASMID_SCREEN:
    raise WorkflowError(
        "run_alignment_analysis, run_denovo_assembly and run_plasmid_screen are "
        "all false -- enable at least one analysis branch in config.yaml."
    )

if RUN_PLASMID_SCREEN and not PLASMID_PANEL_DIR:
    raise WorkflowError(
        "run_plasmid_screen is true but plasmid_panel_dir is not set in config.yaml."
    )


# ----------------------------------------------------------------------
# Samples
# ----------------------------------------------------------------------
samples = (
    pd.read_table(config["sample_sheet"], dtype=str)
      .set_index("sample_name", drop=False)
)

# Fail fast with a clear message if the sheet is malformed.
_required_cols = {"sample_name", "barcode", "ref_fasta"}
_missing = _required_cols - set(samples.columns)
if _missing:
    raise WorkflowError(
        f"sample_sheet is missing required column(s): {', '.join(sorted(_missing))}"
    )

SAMPLE_NAMES = list(samples["sample_name"])


# ----------------------------------------------------------------------
# Wildcard constraints (some samples names have ".*")
# ----------------------------------------------------------------------
wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLE_NAMES) if SAMPLE_NAMES else ".*"


# ----------------------------------------------------------------------
# Include rule modules (relative paths -> portable across machines)
# ----------------------------------------------------------------------
include: "rules/common.smk"
include: "rules/qc.smk"

if RUN_ALIGNMENT:
    include: "rules/align.smk"
if RUN_COVERAGE:
    include: "rules/coverage.smk"
if RUN_MULTIMER:
    include: "rules/multimer.smk"
if RUN_DENOVO:
    include: "rules/assembly.smk"
if RUN_PLASMID_SCREEN:
    include: "rules/plasmid_screen.smk"

include: "rules/summary.smk"


# ----------------------------------------------------------------------
# Target rule
# ----------------------------------------------------------------------
def _rule_all_inputs():
    """Build rule-all targets from the RUN_* toggles above."""
    d = {
        "filtered_fastqs": expand(OUT_DIR + "{sample}/{sample}.filt.fastq.gz", sample=SAMPLE_NAMES),
    }
    if RUN_ALIGNMENT:
        d["sorted_bams"] = expand(OUT_DIR + "{sample}/{sample}.sorted.bam", sample=SAMPLE_NAMES)
        d["align_snps"]  = expand(OUT_DIR + "{sample}/{sample}.simple.tsv", sample=SAMPLE_NAMES)
        d["run_summary"] = OUT_DIR + "summary.tsv"
    if RUN_COVERAGE:
        d["align_cov_logs"] = expand(OUT_DIR + "{sample}/{sample}.cov.log", sample=SAMPLE_NAMES)
    if RUN_MULTIMER:
        d["multimer_logs"] = expand(OUT_DIR + "{sample}/{sample}.multimer.log", sample=SAMPLE_NAMES)
    if RUN_GATC:
        d["gatc_align_snps"]           = expand(OUT_DIR + "{sample}/{sample}.gatc.simple.tsv", sample=SAMPLE_NAMES)
        d["annotated_gatc_align_snps"] = expand(OUT_DIR + "{sample}/{sample}.annotated.gatc.simple.tsv", sample=SAMPLE_NAMES)
    if RUN_DENOVO:
        d["assemblies"]     = expand(OUT_DIR + "{sample}/{sample}.assembly.fasta", sample=SAMPLE_NAMES)
        d["assembly_infos"] = expand(OUT_DIR + "{sample}/{sample}.assembly_info.txt", sample=SAMPLE_NAMES)
    
    if RUN_PLASMID_SCREEN:
        d["chlor_cassette_reads"] = expand(
            OUT_DIR + "plasmidic_reads/{sample}/Chlor_cassette.fastq.gz",
            sample=SAMPLE_NAMES
        )
    
        d["chlor_cassette_reference_bams"] = expand(
            OUT_DIR + "{sample}/plasmidic_reads/{sample}.Chlor_cassette.sorted.bam",
            sample=SAMPLE_NAMES
        )
        
    if RUN_COVERAGE or RUN_PLASMID_SCREEN:
        d["coverage_summary"] = OUT_DIR + "coverage_summary.tsv"
    
    return d


rule all:
    input:
        **_rule_all_inputs()


# ----------------------------------------------------------------------
# Downstream integration rules (only defined when RUN_GATC is on -- they
# consume the reference-based variant table and enrich it with GATC-site
# + gene context, then the multimer verdict)
# ----------------------------------------------------------------------
if RUN_GATC:

    rule id_gatc_variants:
        input:
            ref_fasta   = OUT_DIR + "{sample}/{sample}.ref.fasta",
            align_snps = OUT_DIR + "{sample}/{sample}.simple.tsv",
        output:
            gatc_align_snps = OUT_DIR + "{sample}/{sample}.gatc.simple.tsv",
        log:
            OUT_DIR + "{sample}/logs/id_gatc_variants.log",
        params:
            exe = script("id_gatc", "id_GATC.1.py"),
        shell:
            "python {params.exe} "
            "-ref_fasta {input.ref_fasta} "
            "-variants {input.align_snps} "
            "-out {output.gatc_align_snps} > {log} 2>&1"


    # NOTE: this rule now writes an intermediate table; the multimer column is
    # added by add_multimer_flag below, which produces the final filename.
    rule annotate_gatc_variants:
        input:
            ref            = OUT_DIR + "{sample}/{sample}.ref.gb",
            gatc_align_snps= OUT_DIR + "{sample}/{sample}.gatc.simple.tsv",
        output:
            annotated = temp(OUT_DIR + "{sample}/{sample}.annotated.gatc.nomulti.tsv"),
        log:
            OUT_DIR + "{sample}/logs/annotate_gatc_variants.log",
        params:
            exe = script("annotate", "annotate.1.py"),
        shell:
            "python {params.exe} "
            "-t {input.gatc_align_snps} "
            "-a {input.ref} "
            "-o {output.annotated} > {log} 2>&1"


    if RUN_MULTIMER:
        rule add_multimer_flag:
            """Append the sample-level multimer verdict (yes/no) to the final table."""
            input:
                annotated = OUT_DIR + "{sample}/{sample}.annotated.gatc.nomulti.tsv",
                summary   = OUT_DIR + "{sample}/{sample}.multimer.summary.tsv",
            output:
                annotated_gatc_align_snps = OUT_DIR + "{sample}/{sample}.annotated.gatc.simple.tsv",
            log:
                OUT_DIR + "{sample}/logs/add_multimer_flag.log",
            params:
                exe   = script("multimer_flag", "add_multimer_column.1.py"),
                col   = config.get("multimer_column_name", "multimer"),
                extra = "-extra" if config.get("multimer_extra_columns", False) else "",
            shell:
                "python {params.exe} "
                "-in {input.annotated} "
                "-summary {input.summary} "
                "-col {params.col} {params.extra} "
                "-out {output.annotated_gatc_align_snps} > {log} 2>&1"
    else:
        rule add_multimer_flag:
            """Multimer analysis is off: pass the annotated table through unchanged."""
            input:
                annotated = OUT_DIR + "{sample}/{sample}.annotated.gatc.nomulti.tsv",
            output:
                annotated_gatc_align_snps = OUT_DIR + "{sample}/{sample}.annotated.gatc.simple.tsv",
            log:
                OUT_DIR + "{sample}/logs/add_multimer_flag.log",
            shell:
                r"""cp -- "{input.annotated}" "{output.annotated_gatc_align_snps}" > "{log}" 2>&1"""


# ----------------------------------------------------------------------
# Coverage summary merge (only defined when at least one coverage source
# is active). reference_coverage_summary.tsv (rules/coverage.smk) and
# plasmid_coverage_summary.tsv (rules/plasmid_screen.smk) already share
# one schema (same -name_col/-source convention), so merging is a
# straight concatenation -- this just combines whichever of the two are
# enabled into one coverage_summary.tsv.
# ----------------------------------------------------------------------
if RUN_COVERAGE or RUN_PLASMID_SCREEN:

    def _coverage_summary_sources():
        sources = []
        if RUN_COVERAGE:
            sources.append(OUT_DIR + "reference_coverage_summary.tsv")
        if RUN_PLASMID_SCREEN:
            sources.append(OUT_DIR + "plasmid_coverage_summary.tsv")
        return sources


    rule merge_coverage_summaries:
        """Combine the reference-genome and plasmid-panel coverage tables into one."""
        input:
            _coverage_summary_sources(),
        output:
            summary = OUT_DIR + "coverage_summary.tsv",
        log:
            OUT_DIR + "logs/merge_coverage_summaries.log",
        run:
            header = None
            n_rows = 0
            with open(output.summary, "w") as out_fh, open(log[0], "w") as log_fh:
                for path in input:
                    with open(path) as in_fh:
                        lines = in_fh.read().splitlines()
                    if not lines:
                        log_fh.write(f"skipped {path} (empty)\n")
                        continue
                    if header is None:
                        header = lines[0]
                        out_fh.write(header + "\n")
                    elif lines[0] != header:
                        raise WorkflowError(
                            f"cannot merge {path}: header does not match the "
                            f"other coverage table(s) ({lines[0]!r} vs {header!r})"
                        )
                    for line in lines[1:]:
                        out_fh.write(line + "\n")
                        n_rows += 1
                    log_fh.write(f"merged {path} ({len(lines) - 1} data rows)\n")
                log_fh.write(f"total data rows: {n_rows}\n")
